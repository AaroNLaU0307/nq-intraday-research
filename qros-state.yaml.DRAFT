# DRAFT — not the live state file. Rename to `qros-state.yaml` only after
# Aaron declares the two fields marked AARON_MUST_DECLARE below.
#
# Every other value here is TRANSCRIBED from a canonical ITSF artifact, with
# the source named. Nothing is inferred. Per the ratified §10.2 the DECLARED
# partition is a non-authoritative self-report — canonical artifacts win in
# their domains, always — and per §2.1 the state file is edited only by
# working sessions of this project, which is what wrote this draft.
#
# The CLI's YAML subset takes double-quoted scalars only and no trailing
# comments, so every note here sits on its own line.

schema_version: "17"

# ---------------------------------------------------------------- DECLARED --
# research_id: free value, declares no vocabulary (§2.4).
# S0-T001 is the TRIAL id, not the research id.
research_id: "ITSF-S0"

# lane: FULL | MEASUREMENT | EXPLORATORY, closed, "Never inferred" (§2.4).
#
# AARON_MUST_DECLARE. ITSF has no canonical lane declaration. The only
# `LANE=` strings in this repository sit inside prompt headers THIS SESSION
# wrote, so using them as the basis would be circular — I would be citing my
# own inference back to myself.
#
# RECOMMENDATION: FULL. Basis: a sealed preregistration (tag s0-freeze-v1),
# a Checkpoint-0 kill gate carrying a promotion/falsification decision table
# (prereg §10.4), and a trial registry. That is the FULL shape. The
# MEASUREMENT in my prompt headers described the REVIEW TASK, never the
# project.
lane: "AARON_MUST_DECLARE"

# workflow_stage: A A2 B C D E F G H I J K L, closed (§2.5). The stage
# currently DUE OR IN PROGRESS — not a status, not a verdict.
#
# AARON_MUST_DECLARE. No canonical statement of it exists anywhere.
#
# RECOMMENDATION: C. Basis: S0 itself ran and was revealed, but its verdict
# is INCONCLUSIVE_PENDING_MC — the Checkpoint-0 statistic is produced by the
# MC, and the MC pipeline is under construction (N01–N13). N16 is the
# preregistered run, which is E. So what is in progress is the build.
# Contestable: read the MC as a separate study and ITSF-S0 sits at F,
# awaiting its evidence.
workflow_stage: "AARON_MUST_DECLARE"

# §10.4 requires a one-line `MATERIALITY: ORDINARY | MATERIAL` in the
# measurement plan or preregistration. SEARCHED: no such line exists in this
# repository. The one MATERIALITY string present is
# `MATERIALITY_CONCLUSION=NOT_ESTABLISHED`, in a post-reveal addendum — a
# different statement about a different question. Per §10.4 absence renders
# UNKNOWN, and UNKNOWN holds `F -> L`. Fail-closed and correct; not a gap to
# paper over by declaring ORDINARY.
measurement_materiality: "UNKNOWN"

